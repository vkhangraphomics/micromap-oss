# Neo4j Configuration
NEO4J_PASSWORD=your-secure-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Database name. Neo4j Community Edition only supports the default 'neo4j'.
# Override to 'graphomics' (or another) on Enterprise installs that have created it.
#
# WARNING: every Python read-site of NEO4J_DATABASE (integrations/neo4j_microbiome.py,
# database/load_knowledge_graph.py, database/neo4j_schema.py, etc.) defaults to
# 'graphomics' when the env var is unset — Enterprise-only. docker-compose.yml /
# docker-compose.prod.yml set NEO4J_DATABASE=neo4j explicitly, so the container path
# is safe. The trap is for direct `python -m database.<loader>` runs without a
# loaded .env: code default kicks in → connection fails on Community Edition.
# Always copy this file to .env before running anything outside the compose stack.
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=256M
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512M
# Memory budget on a t3.medium (4GB RAM): Neo4j ~1.5G total (heap + pagecache),
# leaving ~2.5G for the OS, the FastAPI container, and buffers. Earlier defaults
# (heap 2G + pagecache 1G = 3G) caused steady swap on a 4GB instance — see #31.
# For a t3.large (8GB) you can safely bump to heap 2G + pagecache 1G.

# API Configuration
API_PORT=8200
CORS_ORIGINS=http://localhost:3000,https://your-app.com

# API Authentication
# Comma-separated list of valid API keys (leave empty to disable auth)
API_KEYS=
# Decision provenance (#190): map API key -> organization_id, as `key:org` pairs.
# The caller's org is derived from their key (not the request body), so org
# scoping on /provenance/* is a real boundary. Unmapped keys fall back to
# DEFAULT_ORG. Leave empty for single-tenant demo (everything -> DEFAULT_ORG).
API_KEY_ORGS=
DEFAULT_ORG=demo
# Rate limit per API key (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Data Loading (optional - for specific loaders)
NCBI_API_KEY=
HMDB_DATA_PATH=/data/hmdb
DRUGBANK_DATA_PATH=/data/drugbank
CARD_DATA_PATH=/data/card
GUTMDISORDER_DATA_PATH=/data/gutmdisorder
BUGSIGDB_DATA_PATH=/data/bugsigdb
SEMMEDDB_DATA_PATH=/data/semmeddb
MBODYMAP_DATA_PATH=/data/mbodymap

# S3 Data Management (optional - for loading data files from S3)
S3_DATA_BUCKET=graphomics-kg-data
S3_DATA_PREFIX=data/

# MCP org enforcement (#299/#313; activation tracked in #322). The MCP mirror
# of API_KEY_ORGS: `token:org:role` triples, comma-separated. Enforcement is
# gated on identity being configured — with this EMPTY, every MCP caller is
# the default org, raw Cypher (query_graph) is open to any token holder, and
# the server warns at startup. Setting it flips enforcement ON:
#   - map Nexus's shared token as role=service FIRST (it calls query_graph;
#     enforcing without that mapping breaks it — see Nexus#316)
#   - external/tenant tokens get role=user (no raw Cypher, org-scoped tools)
# MCP_TOKEN_ORGS=tok_nexus:graphomics:service,tok_acme:acme-bio:user
# Org -> outbound REST key, so kg_* tools present the CALLER's credential and
# REST derives the org from it (the MCP never asserts an org to REST).
# MCP_ORG_API_KEYS=graphomics:mm_key_a,acme-bio:mm_key_b
# Org for callers with no mapped identity (mirror of REST's DEFAULT_ORG).
# MCP_DEFAULT_ORG=default
# Orgs whose writes may project into the shared reference graph (#284). Set
# explicitly so a first-party write cannot silently become reference truth.
# CANONICAL_ORGS=default

# Federation HTTP contribution path (#206). JSON map: api_key -> write target.
# The bundle never names its target; this server-side map is authoritative.
# FEDERATION_TENANTS={"mm_fed_acme_xxx":{"organization_id":"acme","database":"acme_db","bolt_uri":"bolt://micromap-neo4j:7687","bolt_auth_ref":"env:ACME_BOLT_PW","bolt_user":"mapforge"}}
# ACME_BOLT_PW=...

# JWT + service-account identity (#190 pillar 5). When any verification material
# below is set, a valid `Authorization: Bearer <JWT>` authenticates and its
# claims drive org-scoping (org from JWT_ORG_CLAIM) + role (service accounts use
# role=service). Leave ALL unset to keep today's API-key-only auth (kgdev).
# Pick one verification mode:
# JWT_PUBLIC_KEY=                     # PEM public key  -> RS256 (issuer signs)
# JWKS_URL=                          # JWKS endpoint   -> RS256 (key by kid)
# JWT_SECRET=                        # shared secret   -> HS256 (simple/dev)
# Optional validation + claim names:
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_ORG_CLAIM=org_id
# JWT_USER_CLAIM=sub
# JWT_ROLE_CLAIM=role
# Decision-provenance append-only event log (#190 pillar 2, activated on
# kgdev via #325). When DATABASE_URL is set, every POST
# /api/v1/provenance/decisions is appended to an immutable, org-scoped
# Postgres log (the system of record) — the Neo4j :Decision graph is a
# rebuildable projection. Both docker-compose.yml (dev) and
# docker-compose.prod.yml bundle a `postgres` service and build DATABASE_URL
# from POSTGRES_* below — you don't need to set DATABASE_URL yourself unless
# pointing at an external Postgres. POSTGRES_PASSWORD is REQUIRED in prod
# (fails loud, no default — same rule as NEO4J_PASSWORD, #241 P2); set it
# to disable nothing, there is no "unset to disable" path in prod anymore.
POSTGRES_USER=micromap
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=micromap_provenance
POSTGRES_PORT=5432

# Decision semantic search (#190 pillar 4). Set EMBEDDINGS_PROVIDER=voyage to
# enable vector search over decision summary+rationale (POST /provenance/search).
# Unset → semantic search disabled; the substring /provenance/query is unaffected.
# EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3-lite          # voyage-3-lite=512-dim, voyage-3=1024-dim
# EMBEDDINGS_DIM=                     # override the model's default dimension
