    given-names: Varun
    affiliation: Graphomics
type: software
repository-code: "https://github.com/vkhangraphomics/micromap-oss/tree/main/micromap-mapforge"
license: MIT
keywords:
  - knowledge-graph
  - neo4j
  - biomedical
  - microbiome
  - data-ingestion
  - biocypher
